# TideCloak local development configuration.
# Copy this file to .env, then adjust the values for your demo.
# Never commit .env.

# Pinned image tag. Check https://hub.docker.com/r/tideorg/tidecloak-dev/tags
# before upgrading, and read the release notes first.
TIDECLOAK_VERSION=0.14.41

# 127.0.0.1 keeps the admin console on this machine only.
# Use 0.0.0.0 only when you intentionally want LAN access.
TIDECLOAK_BIND_ADDRESS=127.0.0.1
TIDECLOAK_PORT=8080

# Master admin for the bootstrap wizard at http://localhost:8080
# These variables are read only when the H2 database is empty.
TIDECLOAK_ADMIN_USERNAME=admin
TIDECLOAK_ADMIN_PASSWORD=password

# debug, info, warn, error
TIDECLOAK_LOG_LEVEL=info
